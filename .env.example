# Saerbridge API environment
# Copy to .env and fill in real values. Never commit .env.

NODE_ENV=development
PORT=8080

# PostgreSQL
DATABASE_URL=postgres://saerbridge:saerbridge_dev@localhost:5433/saerbridge

# Session signing secret — generate a long random string (32+ characters)
SESSION_SECRET=replace-with-a-long-random-session-secret
SESSION_IDLE_MS=1209600000

# CSRF signing secret — generate a separate long random string
CSRF_SECRET=replace-with-a-long-random-csrf-secret

# Google Identity Services client ID (public identifier, not a secret)
# Must match the client ID used by the web app.
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com

# Google OAuth client secret — server only. Never expose this to the browser or VITE_* variables.
GOOGLE_CLIENT_SECRET=your-google-client-secret

# Comma-separated browser origins allowed to call this API with credentials.
CLIENT_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:4173

# Production cookie domain for SSO across Saerbridge subdomains.
# Leave empty in local development. In production use:
# COOKIE_DOMAIN=.saerbridge.com
COOKIE_DOMAIN=

# Comma-separated emails granted administrator role after verified Google sign-in.
# Admin status is never accepted from the client.
ADMIN_EMAILS=

# OpenAI — server only. Never expose this key to the browser or VITE_* variables.
OPENAI_ENABLED=false
OPENAI_API_KEY=sk-replace-with-server-only-openai-key
OPENAI_MODEL=gpt-4.1-mini
OPENAI_TIMEOUT_MS=30000
OPENAI_DIAGNOSTIC_LOG_PROMPTS=false

# Retention (days)
SECURITY_AUDIT_RETENTION_DAYS=365
COMPLETED_DATA_RIGHTS_RETENTION_DAYS=730

# Optional legal/company fields — leave blank rather than inventing values
COMPANY_REGISTRATION_NUMBER=
INFORMATION_OFFICER_NAME=
INFORMATION_OFFICER_EMAIL=we@saerbridge.com
INFORMATION_OFFICER_PHONE=
REGISTERED_ADDRESS=

# Test-only. Must never be true in production. Refused at boot if NODE_ENV=production.
ENABLE_TEST_AUTH=false
